ey":"Ts"},{"x":67,"y":38,"key":"Og"}],"powerups":[{"x":5,"y":9,"type":0},{"x":2,"y":16,"type":0},{"x":3,"y":16,"type":0},{"x":4,"y":16,"type":0},{"x":2,"y":17,"type":0},{"x":54,"y":24,"type":0},{"x":28,"y":35,"type":0},{"x":10,"y":26,"type":1},{"x":4,"y":32,"type":1},{"x":25,"y":35,"type":1},{"x":44,"y":23,"type":2},{"x":43,"y":35,"type":2},{"x":62,"y":35,"type":2},{"x":66,"y":35,"type":2},{"x":68,"y":9,"type":0},{"x":67,"y":9,"type":0},{"x":15,"y":3,"type":0}],"enemies":[{"x":48,"y":8,"type":"bat"},{"x":26,"y":12,"type":"snake"},{"x":35,"y":12,"type":"snake"},{"x":40,"y":16,"type":"bat"},{"x":16,"y":26,"type":"crab"},{"x":68,"y":26,"type":"crab"},{"x":30,"y":32,"type":"spider"},{"x":14,"y":38,"type":"spider"},{"x":25,"y":42,"type":"snake"},{"x":13,"y":9,"type":"snake"},{"x":25,"y":2,"type":"bat"},{"x":45,"y":24,"type":"bat"},{"x":60,"y":29,"type":"snake"},{"x":20,"y":35,"type":"bat"},{"x":4,"y":38,"type":"bat"},{"x":49,"y":35,"type":"spider"},{"x":24,"y":40,"type":"bat"},{"x":52,"y":40,"type":"bat"},{"x":40,"y":43,"type":"crab"}],"pads":[{"x":53,"y":33,"key":"Md"},{"x":55,"y":33,"key":"Es"},{"x":57,"y":33,"key":"No"}],"triviaQuestion":"Which element is named after the chemist who published his periodic table in 1869?","triviaAnswer":"Md","triviaTrap":"","triviaPos":{"x":55,"y":34},"hints":[{"x":2,"y":2,"r":2,"icon":"⛏️","title":"THE DEEP ELEMENT RUN","text":"One colossal cavern. <strong>All 94 elements found in nature</strong>. Each hall holds one family of the periodic table. <strong>Finish a family and the clock gains time</strong>; the doors between the halls ask about the family you have just met, so read the signs. Good luck, miner!"},{"x":12,"y":3,"r":1,"icon":"🌱","title":"NONMETALS","text":"The elements of <strong>life itself</strong> - carbon, oxygen, nitrogen… You are mostly made of this hall. The halogens and noble gases are nonmetals too, with halls of their own - so this family is called the <em>other nonmetals</em>."},{"x":42,"y":3,"r":1,"icon":"🧪","title":"HALOGENS","text":"Salt-formers - fiercely reactive, and <em>toxic as gases</em>. Those barrels? <strong>Walk east and shove them</strong> - each drops down a chute, and the blast cracks the ice vault holding a halogen."},{"x":69,"y":6,"r":1,"icon":"👑","title":"NOBLE GASES","text":"The loners of chemistry: they react with almost <strong>nothing</strong>. Fittingly, someone locked them away. One key lies here. <strong>The other two were dropped in the flooded hall to the west</strong>."},{"x":43,"y":9,"r":1,"icon":"💥","title":"ALKALI METALS","text":"Soft, shiny metals that all <strong>react with water</strong> - some of them violently. Naturally, this hall is flooded. Keep your head up and watch for swimmers."},{"x":18,"y":9,"r":1,"icon":"🦴","title":"ALKALINE EARTH METALS","text":"Calcium in your bones, magnesium in your greens - the sturdy builders of the mineral world."},{"x":2,"y":14,"r":1,"icon":"💻","title":"METALLOIDS","text":"Half metal, half not - silicon is at the heart of nearly every computer chip. Their crystals hide behind <strong>glacial ice</strong>: dynamite time (press 1, then RUN)."},{"x":26,"y":16,"r":1,"icon":"🥫","title":"OTHER METALS","text":"The metals to the right of the transition metals - aluminium cans, tin solder, lead pipes. Most are soft and melt easily: gallium would melt in your hand. Mind the old rail carts."},{"x":47,"y":22,"r":1,"icon":"⚙️","title":"TRANSITION METALS","text":"The <strong>backbone of civilisation</strong> - iron, copper, gold, titanium. They lie <strong>in order of atomic number</strong>: east along the top gallery from scandium, back west along the middle one, east again along the bottom to mercury. The machines still run. Cross with care."},{"x":5,"y":31,"r":1,"icon":"🧲","title":"LANTHANIDES","text":"Fifteen of the seventeen <em>rare earths</em> - magnets in your headphones, colours in your screen. Not actually rare, just devilishly hard to separate. It's dark down here - lamps on (press 2), and tread quietly."},{"x":40,"y":35,"r":1,"icon":"☢️","title":"ACTINIDES","text":"Radioactive heavyweights - uranium, thorium, plutonium. Real uranium ore does not glow - the <strong>glowing</strong> veins down here are lava. Never dig glowing ground."},{"x":57,"y":35,"r":1,"icon":"🔬","title":"THE SYNTHETICS VAULT","text":"Beyond this door lie elements <strong>no mine has ever held</strong> - people made them in reactors and laboratories, the heaviest only a few atoms at a time. Answer the question to enter; hunt them with the Geiger Counter (press 3). Pure bonus - the core does not wait for them."},{"x":45,"y":41,"r":1,"icon":"🌍","title":"THE CORE","text":"You hold every element found in nature. <strong>Step into the core and finish your run</strong> - but tread lightly: <em>something guards it</em>."},{"x":9,"y":7,"r":3,"icon":"⛑️","title":"REFUGE CHAMBER","text":"Real mines keep sealed <strong>refuge chambers</strong> stocked with air and water. Step inside to <strong>save your progress</strong> - if the deep claims you, you respawn here. There are three on the way down."}],"gates":[{"question":"Which halogen is a liquid at room temperature?","answer":"Br","pos":{"x":68,"y":3},"pads":[{"x":66,"y":2,"key":"Br"},{"x":68,"y":2,"key":"Cl"},{"x":70,"y":2,"key":"I"}],"doors":[{"x":69,"y":7}]},{"question":"Which metalloid are most computer chips made from?","answer":"Si","pos":{"x":21,"y":16},"pads":[{"x":19,"y":15,"key":"Si"},{"x":21,"y":15,"key":"Ge"},{"x":23,"y":15,"key":"As"}],"doors":[{"x":24,"y":16}]},{"question":"Which of these metals melts in the warmth of your hand?","answer":"Ga","pos":{"x":47,"y":19},"pads":[{"x":48,"y":18,"key":"Ga"},{"x":48,"y":19,"key":"Al"},{"x":48,"y":20,"key":"Pb"}],"doors":[{"x":47,"y":21}]},{"question":"Which actinide fuels most nuclear power stations?","answer":"U","pos":{"x":45,"y":38},"pads":[{"x":43,"y":39,"key":"U"},{"x":47,"y":39,"key":"Th"},{"x":49,"y":39,"key":"Pu"}],"doors":[{"x":45,"y":39}]}],"families":[{"name":"Other nonmetals","keys":["H","C","N","O","P","S","Se"],"bonus":30,"color":"#7bd88f"},{"name":"Halogens","keys":["F","Cl","Br","I","At"],"bonus":60,"color":"#ffd166"},{"name":"Noble gases","keys":["He","Ne","Ar","Kr","Xe","Rn"],"bonus":60,"color":"#c792ea"},{"name":"Alkali metals","keys":["Li","Na","K","Rb","Cs","Fr"],"bonus":50,"color":"#ff7b7b"},{"name":"Alkaline earth metals","keys":["Be","Mg","Ca","Sr","Ba","Ra"],"bonus":30,"color":"#ffb86b"},{"name":"Metalloids","keys":["B","Si","Ge","As","Sb","Te"],"bonus":55,"color":"#5ad1a0"},{"name":"Other metals","keys":["Al","Ga","In","Sn","Tl","Pb","Bi","Po"],"bonus":70,"color":"#9aa7b8"},{"name":"Transition metals · Sc to Zn","keys":["Sc","Ti","V","Cr","Mn","Fe","Co","Ni","Cu","Zn"],"bonus":55,"color":"#6ec6ff"},{"name":"Transition metals · Y to Cd","keys":["Y","Zr","Nb","Mo","Tc","Ru","Rh","Pd","Ag","Cd"],"bonus":55,"color":"#5aa9e6"},{"name":"Transition metals · Hf to Hg","keys":["Hf","Ta","W","Re","Os","Ir","Pt","Au","Hg"],"bonus":55,"color":"#4a8fd0"},{"name":"Lanthanides","keys":["La","Ce","Pr","Nd","Pm","Sm","Eu","Gd","Tb","Dy","Ho","Er","Tm","Yb","Lu"],"bonus":70,"color":"#f78fb3"},{"name":"Actinides · Ac to Pu","keys":["Ac","Th","Pa","U","Np","Pu"],"bonus":30,"color":"#e06c75"}],"run":{"id":"deep","tag":"THE GRAND TOUR · 94 ELEMENTS","color":"#ffb84d","blurb":"Hall after hall, one family of elements in each. Finish a family to win time, and answer the door to go deeper.","winLine":"All 94 elements found in nature, family by family.","winSub":"Twelve families, from the nonmetals to the actinides"}}